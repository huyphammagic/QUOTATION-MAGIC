    match /deadlineAuditLogs/{logId} {
      allow read: if isResourceMember();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isIncomingMember();
      allow update, delete: if false;
    }
    match /followUpTouchpoints/{touchpointId} {
      allow read: if isResourceMember();
