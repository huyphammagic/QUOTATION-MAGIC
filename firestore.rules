      allow update: if isResourceMember() && preservesCompanyId() && canCreateQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Default deny catch-all
    match /{document=**} {
