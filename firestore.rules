rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // 1. CORE SECURITY, AUTHENTICATION & MULTI-COMPANY RBAC HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'huypham.magic@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Resolves membership document for the authenticated user in target company
    function getMembership(companyId) {
      return get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)).data;
    }

    // Checks if the authenticated user has an ACTIVE membership in the target company
    // Strictly requires document existence in companyMemberships - ZERO hardcoded bypasses
    function isCompanyMember(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)).data.status == 'ACTIVE'
        )
      );
    }

    function getMemberRole(companyId) {
      return getMembership(companyId).role;
    }

    // Checks if the user has COMPANY_ADMIN role in the target company
    function isCompanyAdmin(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          getMemberRole(companyId) == 'COMPANY_ADMIN'
        )
      );
    }

    // Granular Role & Permission Checks
    function canCreateQuotes(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          (
            getMemberRole(companyId) in ['COMPANY_ADMIN', 'LOGISTICS_MANAGER', 'PRICING_SPECIALIST', 'SALES_REP'] ||
            getMembership(companyId).permissions.canCreateQuotes == true
          )
        )
      );
    }

    function canApproveQuotes(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          (
            getMemberRole(companyId) in ['COMPANY_ADMIN', 'LOGISTICS_MANAGER'] ||
            getMembership(companyId).permissions.canApproveQuotes == true
          )
        )
      );
    }

    function canManageRates(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          (
            getMemberRole(companyId) in ['COMPANY_ADMIN', 'LOGISTICS_MANAGER', 'PRICING_SPECIALIST'] ||
            getMembership(companyId).permissions.canManageRates == true
          )
        )
      );
    }

    function canManageOperations(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          getMemberRole(companyId) in ['COMPANY_ADMIN', 'LOGISTICS_MANAGER', 'OPERATOR', 'SALES_REP']
        )
      );
    }

    function canManageMembers(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          (
            getMemberRole(companyId) == 'COMPANY_ADMIN' ||
            getMembership(companyId).permissions.canManageMembers == true
          )
        )
      );
    }

    function canEditCompanyProfile(companyId) {
      return isAuthenticated() && (
        isSystemAdmin() ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + '_' + companyId)) &&
          (
            getMemberRole(companyId) == 'COMPANY_ADMIN' ||
            getMembership(companyId).permissions.canEditCompanyProfile == true
          )
        )
      );
    }

    // Company Scoping Helpers
    function isResourceMember() {
      return isAuthenticated() && (
        isSystemAdmin() ||
        ('companyId' in resource.data && isCompanyMember(resource.data.companyId))
      );
    }

    function isIncomingMember() {
      return isAuthenticated() && (
        isSystemAdmin() ||
        ('companyId' in request.resource.data && isCompanyMember(request.resource.data.companyId))
      );
    }

    // Prevents tampering with tenant isolation by re-assigning companyId
    function preservesCompanyId() {
      return !('companyId' in request.resource.data) || request.resource.data.companyId == resource.data.companyId;
    }

    // =========================================================================
    // 2. MULTI-TENANT COMPANIES & COMPANY MEMBERSHIPS
    // =========================================================================
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow create: if isAuthenticated() && (
        isSystemAdmin() ||
        (
          request.resource.data.companyId == companyId &&
          !exists(/databases/$(database)/documents/companies/$(companyId)) &&
          (
            request.resource.data.createdBy == request.auth.uid ||
            request.resource.data.createdBy == request.auth.token.email
          )
        )
      );
      allow update: if canEditCompanyProfile(companyId);
      allow delete: if false;

      match /{document=**} {
        allow read: if isCompanyMember(companyId);
        allow write: if isCompanyAdmin(companyId);
      }
    }

    match /companyMemberships/{membershipId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid ||
        isCompanyAdmin(resource.data.companyId)
      );
      
      // Membership creation strictly guarded:
      // 1. System Root Admin (isSystemAdmin()) bootstrapping / management
      // 2. Company Admin adding a member to their company
      // 3. Authenticated user creating a new company establishing initial COMPANY_ADMIN
      allow create: if isAuthenticated() && (
        isSystemAdmin() ||
        isCompanyAdmin(request.resource.data.companyId) ||
        (
          request.resource.data.userId == request.auth.uid && 
          request.resource.data.role == 'COMPANY_ADMIN' &&
          membershipId == request.auth.uid + '_' + request.resource.data.companyId &&
          !exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
        )
      );

      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        isCompanyAdmin(resource.data.companyId)
      );
      allow delete: if isAuthenticated() && (
        isSystemAdmin() ||
        isCompanyAdmin(resource.data.companyId)
      );
    }

    // Company Financial, Tax, Payment, Bank sub-settings
    match /companyFinancialSettings/{docId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /companyTaxConfigurations/{docId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /companyPaymentTerms/{docId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /companyBankAccounts/{docId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /companyCommercialSettings/{docId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /companyFinancialAudits/{auditId} {
      allow read: if isResourceMember();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isIncomingMember();
      allow update, delete: if false;
    }

    // =========================================================================
    // 3. CORE BUSINESS COLLECTIONS: QUOTATIONS, CUSTOMERS & RATES
    // =========================================================================
    match /quotes/{quoteId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && (
        (!('status' in resource.data) || !(resource.data.status in ['APPROVED', 'SENT', 'ACCEPTED']) || canApproveQuotes(resource.data.companyId)) &&
        (canCreateQuotes(resource.data.companyId) || canApproveQuotes(resource.data.companyId))
      );
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId) && (
        !('status' in resource.data) || !(resource.data.status in ['APPROVED', 'SENT', 'ACCEPTED'])
      );
    }

    match /customers/{customerId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && (
        canCreateQuotes(request.resource.data.companyId) ||
        isCompanyAdmin(request.resource.data.companyId)
      );
      allow update: if isResourceMember() && preservesCompanyId() && (
        canCreateQuotes(resource.data.companyId) ||
        isCompanyAdmin(resource.data.companyId)
      );
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /rateMasters/{rateId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }

    match /chargeMasters/{chargeId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }

    match /rateHistories/{historyId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update, delete: if false;
    }

    match /surcharges/{surchargeId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }

    // Hardened Settings & Master Data (Eliminating broad allow read, write: if isAuthenticated())
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        settingId == 'ui_preferences' ||
        isSystemAdmin()
      );
      allow delete: if false;
    }

    match /masterData/{masterId} {
      allow read: if isAuthenticated();
      // Allow initial seeding of default presets
      allow create: if isAuthenticated();
      // Updates and deletes restricted to system admin
      allow update, delete: if isAuthenticated() && (
        request.auth.token.email == 'huypham.magic@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /quotationDrafts/{draftId} {
      allow read: if isAuthenticated() && (
        !('userId' in resource.data) || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        !('userId' in resource.data) || resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        !('userId' in resource.data) || resource.data.userId == request.auth.uid
      );
    }

    // =========================================================================
    // 4. DOCUMENTS, COMMUNICATIONS & EXTERNAL SECURE PORTAL
    // =========================================================================
    match /quotationDocuments/{documentId} {
      allow get: if isResourceMember() || (
        resource.data.documentType in ['CUSTOMER_QUOTATION', 'CONFIRMATION_NOTICE']
      );
      allow list: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canCreateQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /quotationTemplates/{templateId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /quotationTerms/{termId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /quotationAuditLogs/{logId} {
      allow read: if isResourceMember();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isIncomingMember();
      allow update, delete: if false;
    }

    match /quotationCommunications/{commId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canCreateQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Customer Public/Secure Portal: Viewing secure link token
    match /quotationLinks/{linkId} {
      allow read: if true;
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canCreateQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Customer Response: Client submitting acceptance/rejection/revision
    match /quotationResponses/{responseId} {
      allow read: if isResourceMember();
      allow create: if (
        request.resource.data.linkId is string &&
        request.resource.data.companyId is string &&
        exists(/databases/$(database)/documents/quotationLinks/$(request.resource.data.linkId)) &&
        get(/databases/$(database)/documents/quotationLinks/$(request.resource.data.linkId)).data.companyId == request.resource.data.companyId &&
        request.resource.data.responseType in ['ACCEPTED', 'REJECTED', 'REVISION_REQUESTED']
      );
      allow update, delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /followUps/{followUpId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canCreateQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /emailTemplates/{templateId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /communicationJobs/{jobId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canCreateQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Phase 54: Real-time Customer Engagement Telemetry & Hot Lead Radar
    match /quotationEngagements/{engagementId} {
      allow read: if isResourceMember();
      allow create, update: if (
        request.resource.data.companyId is string &&
        request.resource.data.quotationId is string
      );
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Phase 55: Deal-Closing Accelerator & Negotiation Outcomes
    match /quotationDealOutcomes/{outcomeId} {
      allow read: if isResourceMember();
      allow create, update: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Phase 56: Smart RFQ Inbox & Parser
    match /smartRfqInbox/{rfqId} {
      allow read: if isResourceMember();
      allow create, update: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Phase 57: Competitor Intelligence & Win/Loss Records (Lựa Chọn 1)
    match /competitorWinLossRecords/{recordId} {
      allow read: if isResourceMember();
      allow create, update: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Phase 58: Customer Re-engagement & Lane Replenishment (Lựa Chọn 2)
    match /customerReengagementAlerts/{alertId} {
      allow read: if isResourceMember();
      allow create, update: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Phase 59: Validity & Surcharge Volatility Alerts (Lựa Chọn 3)
    match /rateValiditySurchargeAlerts/{alertId} {
      allow read: if isResourceMember();
      allow create, update: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // Phase 60: AI Demurrage & Detention Simulations (Lựa Chọn 4)
    match /demDetSimulations/{simId} {
      allow read: if isResourceMember();
      allow create, update: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // =========================================================================
    // 5. SUPPLIERS, CARRIERS, RATE APPROVALS & CONTRACTS
    // =========================================================================
    match /suppliers/{supplierId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }

    match /carriers/{carrierId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }

    match /rateApprovals/{approvalId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canApproveQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /rateRequests/{requestId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canCreateQuotes(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    match /importJobs/{jobId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }

    match /missingRateEvents/{eventId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }

    match /contracts/{contractId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /contractRates/{rateId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }
    match /contractVersions/{versionId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }
    match /contractDocuments/{documentId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageRates(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageRates(resource.data.companyId);
      allow delete: if isResourceMember() && canManageRates(resource.data.companyId);
    }
    match /contractAudits/{auditId} {
      allow read: if isResourceMember();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isIncomingMember();
      allow update, delete: if false;
    }

    // Pricing Policies & Audits
    match /pricingPolicies/{policyId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /pricingAudits/{auditId} {
      allow read: if isResourceMember();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isIncomingMember();
      allow update, delete: if false;
    }

    match /analyticsSummaries/{summaryId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && isCompanyAdmin(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && isCompanyAdmin(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }

    // =========================================================================
    // 6. SYSTEM HEALTH, INTEGRITY & LOGISTICS OPERATIONS
    // =========================================================================
    match /dataIntegrityIssues/{issueId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageOperations(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageOperations(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /systemHealthAudits/{auditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /shipments/{shipmentId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageOperations(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageOperations(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /shipmentAuditLogs/{logId} {
      allow read: if isResourceMember();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isIncomingMember();
      allow update, delete: if false;
    }
    match /shipmentTasks/{taskId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageOperations(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageOperations(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /shipmentExceptions/{exceptionId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canManageOperations(request.resource.data.companyId);
      allow update: if isResourceMember() && preservesCompanyId() && canManageOperations(resource.data.companyId);
      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /controlTowerSummaries/{summaryId} {
      allow read: if isResourceMember();
