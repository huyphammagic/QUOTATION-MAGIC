      allow delete: if isResourceMember() && isCompanyAdmin(resource.data.companyId);
    }
    match /crmAuditLogs/{logId} {
      allow read: if isResourceMember();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isIncomingMember();
      allow update, delete: if false;
    }

    match /businessOpportunities/{oppId} {
      allow read: if isResourceMember();
      allow create: if isIncomingMember() && canCreateQuotes(request.resource.data.companyId);
