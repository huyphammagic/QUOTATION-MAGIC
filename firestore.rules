rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default rule for application collections
    // Quotes collection: Read, Write for authenticated users (or public for demo with validation)
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Customers directory
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Surcharges catalog
    match /surcharges/{surchargeId} {
      allow read, write: if true;
    }

    // Company Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Logistics Master Rates
    match /rateMasters/{rateId} {
      allow read, write: if true;
    }

    // Master Charges (Standard Charge Codes)
    match /chargeMasters/{chargeId} {
      allow read, write: if true;
    }

    // Master Rate Audit Histories
    match /rateHistories/{historyId} {
      allow read, write: if true;
    }

    // Phase 7: Professional Quotation Documents & Snapshots
    match /quotationDocuments/{documentId} {
      allow read, write: if true;
    }

    // Phase 7: Quotation Templates
    match /quotationTemplates/{templateId} {
      allow read, write: if true;
    }

    // Phase 7: Quotation Terms Master Templates
    match /quotationTerms/{termId} {
      allow read, write: if true;
    }

    // Phase 7: Quotation Audit Logs
    match /quotationAuditLogs/{logId} {
      allow read, write: if true;
    }

    // Phase 8: Quotation Communications (Email History & Dispatch)
    match /quotationCommunications/{commId} {
      allow read, write: if true;
    }

    // Phase 8: Secure Quotation Links
    match /quotationLinks/{linkId} {
      allow read, write: if true;
    }

    // Phase 8: Customer Responses (Accept / Reject / Revision Requests)
    match /quotationResponses/{responseId} {
      allow read, write: if true;
    }

    // Phase 8: Sales Follow-Up Tasks
    match /followUps/{followUpId} {
      allow read, write: if true;
    }

    // Phase 8: Email Templates
    match /emailTemplates/{templateId} {
      allow read, write: if true;
    }

    // Phase 8: Async Communication Jobs Queue
    match /communicationJobs/{jobId} {
      allow read, write: if true;
    }

    // Phase 10: Logistics Suppliers Master
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Phase 10: Logistics Carriers Master
    match /carriers/{carrierId} {
      allow read, write: if true;
    }

    // Phase 10: Rate Approval Requests
    match /rateApprovals/{approvalId} {
      allow read, write: if true;
    }

    // Phase 10: Sales to Pricing Rate Requests
    match /rateRequests/{requestId} {
      allow read, write: if true;
    }

    // Phase 13: Bulk Rate Import Jobs
    match /importJobs/{jobId} {
      allow read, write: if true;
    }

    // Phase 13: Missing Rate Detection Events
    match /missingRateEvents/{eventId} {
      allow read, write: if true;
    }

    // Phase 14: Customer & Supplier Contracts
    match /contracts/{contractId} {
      allow read, write: if true;
    }

    // Phase 14: Contract Rates
    match /contractRates/{rateId} {
      allow read, write: if true;
    }

    // Phase 14: Contract Versions
    match /contractVersions/{versionId} {
      allow read, write: if true;
    }

    // Phase 14: Contract Documents
    match /contractDocuments/{documentId} {
      allow read, write: if true;
    }

    // Phase 14: Contract Audits
    match /contractAudits/{auditId} {
      allow read, write: if true;
    }

    // Phase 15: Pricing Policies
    match /pricingPolicies/{policyId} {
      allow read, write: if true;
    }

    // Phase 15: Pricing Audits
    match /pricingAudits/{auditId} {
      allow read, write: if true;
    }

    // Phase 16: Analytics Summaries
    match /analyticsSummaries/{summaryId} {
      allow read, write: if true;
    }

    // Phase 17: Quotation Active Drafts (Cloud Persistence)
    match /quotationDrafts/{draftId} {
      allow read, write: if true;
    }

    // Phase 17: Master Data (Ports, Airports, Incoterms, Countries, Currencies)
    match /masterData/{masterId} {
      allow read, write: if true;
    }

    // Phase 17 & Phase 37: Multi-tenant Company Hierarchy & Companies
    match /companies/{companyId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Phase 38: Multi-Company Financial & Commercial Collections
    match /companyFinancialSettings/{docId} {
      allow read, write: if true;
    }
    match /companyTaxConfigurations/{docId} {
      allow read, write: if true;
    }
    match /companyPaymentTerms/{docId} {
      allow read, write: if true;
    }
    match /companyBankAccounts/{docId} {
      allow read, write: if true;
    }
    match /companyCommercialSettings/{docId} {
      allow read, write: if true;
    }
    match /companyFinancialAudits/{auditId} {
      allow read, write: if true;
    }

    // Phase 37: Company Memberships
    match /companyMemberships/{membershipId} {
      allow read, write: if true;
    }

    // Phase 27: System Health & Data Integrity Issue Center
    match /dataIntegrityIssues/{issueId} {
      allow read, write: if true;
    }

    // Phase 27: System Health Audits & Concurrency Logs
    match /systemHealthAudits/{auditId} {
      allow read, write: if true;
    }

    // Phase 41: Smart Shipment & Logistics Operational Workspace
    match /shipments/{shipmentId} {
      allow read, write: if true;
    }
    match /shipmentAuditLogs/{logId} {
      allow read, write: if true;
    }
    match /shipmentTasks/{taskId} {
      allow read, write: if true;
    }

    // Phase 42: Logistics Control Tower & Exception Management Engine
    match /shipmentExceptions/{exceptionId} {
      allow read, write: if true;
    }
    match /controlTowerSummaries/{summaryId} {
      allow read, write: if true;
    }

    // Phase 43: Logistics Event & Milestone Intelligence Engine
    match /shipmentEvents/{eventId} {
      allow read, write: if true;
    }

    // Phase 44 & 48: Smart Logistics Deadline & Action Intelligence Engine
    match /deadlines/{deadlineId} {
      allow read, write: if true;
    }
    match /deadlineAuditLogs/{logId} {
      allow read, write: if true;
    }
    // Phase 49: Follow-Up Touchpoints & Cadence Control
    match /followUpTouchpoints/{touchpointId} {
      allow read, write: if true;
    }

    // Phase 45: Customer Relationship, Rate Review & Sales Follow-Up Intelligence Engine
    match /customerActivities/{activityId} {
      allow read, write: if true;
    }
    match /customerFollowUps/{followUpId} {
      allow read, write: if true;
    }
    match /customerContacts/{contactId} {
      allow read, write: if true;
    }
    match /rateReviewSchedules/{scheduleId} {
      allow read, write: if true;
    }
    match /rateReviewTasks/{taskId} {
      allow read, write: if true;
    }
    match /customerOpportunities/{oppId} {
      allow read, write: if true;
    }
    match /crmAuditLogs/{logId} {
      allow read, write: if true;
    }

    // Phase 46: Business Opportunity Radar & Customer Growth Intelligence Engine
    match /businessOpportunities/{oppId} {
      allow read, write: if true;
    }
    match /opportunityAuditLogs/{logId} {
      allow read, write: if true;
    }

    // Phase 47: Logistics Business Decision & Scenario Workspace
    match /decisionSnapshots/{snapshotId} {
      allow read, write: if true;
    }
    match /decisionScenarios/{scenarioId} {
      allow read, write: if true;
    }
  }
}
