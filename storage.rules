rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Global logistics cloud storage: accessible from any computer without login gating
    match /companies/{companyId}/logo/{allPaths=**} {
      allow read, write: if true;
    }

    match /companies/{companyId}/quotations/{quoteId}/{allPaths=**} {
      allow read, write: if true;
    }

    match /companies/{companyId}/contracts/{contractId}/{allPaths=**} {
      allow read, write: if true;
    }

    match /contracts/{contractId}/{allPaths=**} {
      allow read, write: if true;
    }

    match /companies/{companyId}/documents/{allPaths=**} {
      allow read, write: if true;
    }

    match /publicQuotations/{allPaths=**} {
      allow read, write: if true;
    }

    // Master cross-device JSON snapshot and backup files
    match /systemBackups/{allPaths=**} {
      allow read, write: if true;
    }

    match /cloudSync/{allPaths=**} {
      allow read, write: if true;
    }

    // Default open access for application assets across all devices
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
