rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Direct, instant access for logistics media, PDFs, contracts, and documents
    match /companies/{companyId}/logo/{allPaths=**} {
      allow read, write: if true;
    }

    match /companies/{companyId}/quotations/{quoteId}/{allPaths=**} {
      allow read, write: if true;
    }

    match /companies/{companyId}/contracts/{contractId}/{allPaths=**} {
      allow read, write: if true;
    }

    match /contracts/{contractId}/{allPaths=**} {
      allow read, write: if true;
    }

    match /companies/{companyId}/documents/{allPaths=**} {
      allow read, write: if true;
    }

    match /publicQuotations/{allPaths=**} {
      allow read, write: if true;
    }

    // Default open access for application assets without authentication delay
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}

